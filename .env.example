# osu!-агент: СПРАВОЧНИК конфигурации, НЕ файл времени выполнения.
# Скрипты принимают параметры аргументами командной строки; здесь зафиксированы
# значения по умолчанию и смысл каждого параметра. Реальный .env в git не попадает.

# Файл карты .osu — аргумент --osu (обязательный)
OSU_BEATMAP=beatmaps/my_map.osu

# Аудиотрек карты — аргумент --audio (обязательный)
OSU_AUDIO=beatmaps/my_track.mp3

# Устройство вывода для loopback-захвата — аргумент --device
OSU_AUDIO_DEVICE=Speakers (Realtek(R) Audio)

# Компенсация S, секунды: аудио-латентность + задержка ввода — аргумент --s-offset.
# "auto" подбирает значение по типу якоря: 0.10 (детект по громкости) или
# 0.095 (корреляционный якорь).
OSU_S_OFFSET=auto

# Привязка главного потока к логическому ядру — аргумент --cpu.
# -1 означает «последнее ядро»; пусто — без привязки.
OSU_CPU=-1
